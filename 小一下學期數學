function renderMap(){levelMap.innerHTML='';levels.forEach((l,i)=>{const b=document.createElement('button');b.className='level '+(i===qLevel(state.idx)?'active ':'')+(state.badges.includes(i)?'done':'');b.innerHTML=`<b>${l.icon} Level ${i+1}：${l.name}</b><span class="badge">${state.badges.includes(i)?'🏅':'🔒'}</span><span class="topic">${l.topic}</span>`;b.onclick=()=>{state.idx=i*10;state.tries=3;state.answered=false;showQ();};levelMap.appendChild(b);});}
function showQ(){const q=raw[state.idx], li=qLevel(state.idx), l=levels[li]; levelTitle.textContent=`${l.icon} Level ${li+1}：${l.name}｜${l.topic}`; monster.textContent=l.icon; speech.textContent='選出正確答案，幫 MathMon 收集能量！'; qNo.textContent=`第${state.idx+1}/100題`; tries.textContent=`機會：${state.tries}`; streak.textContent=`連續答對：${state.streak}`; progress.style.width=`${state.idx}%`; question.textContent=q[0]; feedback.className='feedback'; feedback.style.display='none'; nextBtn.style.display='none'; answers.innerHTML=''; q[1].forEach((a,i)=>{let btn=document.createElement('button');btn.className='ans';btn.textContent=String.fromCharCode(65+i)+'. '+a;btn.onclick=()=>choose(i,btn);answers.appendChild(btn)});renderMap();updateStats();save();}
function choose(i,btn){if(state.answered)return; state.attempts++; const q=raw[state.idx], ok=i===q[2]; if(ok){btn.classList.add('correct');state.answered=true;state.gems+=5;state.exp+=5;state.completed=Math.max(state.completed,state.idx+1); if(state.tries===3)state.correctFirst++; state.streak++; if(state.streak>0 && state.streak%3===0){state.gems+=10; feedback.innerHTML='🎉 Good Job！連續答對3題！⭐ +5 EXP　💎 +15 Gems';} else feedback.innerHTML='🎉 Good Job！⭐ +5 EXP　💎 +5 Gems'; feedback.className='feedback good'; feedback.style.display='block'; nextBtn.style.display='inline-block'; speech.textContent='太好了！小精靈升級了！'; checkBadge();}else{btn.classList.add('wrong'); state.tries--; state.streak=0; addWrong(q); if(state.tries>0){feedback.innerHTML=`💡 提示：${q[3]}<br>請再試一次，你還有 ${state.tries} 次機會。`; feedback.className='feedback bad'; feedback.style.display='block'; tries.textContent=`機會：${state.tries}`;}else{feedback.innerHTML=`正確答案是：${q[1][q[2]]}<br>不要緊，下一題再努力！`; feedback.className='feedback bad'; feedback.style.display='block'; state.answered=true; nextBtn.style.display='inline-block';}}
updateStats();save();}
function addWrong(q){const topic=levels[qLevel(state.idx)].topic;state.topicWrong[topic]=(state.topicWrong[topic]||0)+1;if(!state.wrong.some(w=>w.q===q[0])) state.wrong.push({q:q[0],ans:q[1][q[2]],tip:q[3],topic});renderWrong();}
function nextQuestion(){if(state.idx<99){state.idx++;state.tries=3;state.answered=false;showQ()}else{openModal('👑 恭喜成為 MathMon Master！',`你完成100題！共得到 ${state.gems} Gems 和 ${state.badges.length} 枚徽章。`)}}
function checkBadge(){const li=qLevel(state.idx); if((state.idx+1)%10===0 && !state.badges.includes(li)){state.badges.push(li);openModal('🏅 獲得新徽章！',`你完成了 ${levels[li].name}，得到「${levels[li].topic}徽章」！`);}}
function updateStats(){gems.textContent=state.gems;exp.textContent=state.exp;badges.textContent=state.badges.length;doneCount.textContent=state.completed;wrongCount.textContent=state.wrong.length;let acc=state.attempts?Math.round(state.correctFirst/state.attempts*100):0;accuracy.textContent=acc+'%';let weak=Object.entries(state.topicWrong).sort((a,b)=>b[1]-a[1])[0];weakTopic.textContent=weak?weak[0]:'-';renderWrong();}
function renderWrong(){wrongList.innerHTML=state.wrong.length?'':'暫時沒有錯題。';state.wrong.forEach(w=>{const d=document.createElement('div');d.className='wrong-item';d.innerHTML=`<b>${w.topic}</b><br>${w.q}<br>✅ ${w.ans}<br>💡 ${w.tip}`;wrongList.appendChild(d);});}
function toggleDrawer(id){document.getElementById(id).classList.toggle('show')}
function readQuestion(){const u=new SpeechSynthesisUtterance(question.textContent);u.lang='zh-HK';speechSynthesis.cancel();speechSynthesis.speak(u)}
function resetGame(){if(confirm('確定要重設遊戲進度？')){localStorage.removeItem('mathmonState');state={idx:0,gems:0,exp:0,badges:[],tries:3,streak:0,answered:false,attempts:0,correctFirst:0,completed:0,wrong:[],topicWrong:{}};showQ();}}
function openModal(t,txt){modalTitle.textContent=t;modalText.textContent=txt;modal.classList.add('show')}function closeModal(){modal.classList.remove('show')}
load();showQ();
</script>
</body>
